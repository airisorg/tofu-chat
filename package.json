{
  "name": "relay-chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/verify-database.ts && tsx scripts/tofu-schema.ts && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:backend": "tsx --test tests/backend.test.ts tests/database.test.ts",
    "test:ux": "playwright test",
    "test:platform": "playwright test --config playwright.platform.config.ts",
    "test:reliability": "playwright test --config playwright.reliability.config.ts",
    "test:unit": "tsx scripts/test-node.ts",
    "test:network": "playwright test --config playwright.network-ux.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:spacing": "playwright test --config playwright.spacing.config.ts",
    "test:geometry": "playwright test --config playwright.geometry.config.ts",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "test:emoji": "playwright test --config playwright.emoji.config.ts",
    "test:media": "playwright test --config playwright.media.config.ts",
    "test:mini": "playwright test --config playwright.mini.config.ts",
    "test:voice": "playwright test --config playwright.voice.config.ts",
    "test:interaction": "playwright test --config playwright.interaction.config.ts",
    "test:security": "playwright test --config playwright.security.config.ts",
    "test:frontend-security": "playwright test --config playwright.frontend-security.config.ts",
    "test:review-followups": "playwright test --config playwright.review-followups.config.ts",
    "test:profile": "playwright test --config playwright.profile.config.ts",
    "test:header-sidebar": "playwright test --config playwright.header-sidebar.config.ts",
    "test:dialog-visual": "playwright test --config playwright.dialog-visual.config.ts",
    "test:home-toolbar": "playwright test --config playwright.home-toolbar.config.ts",
    "test:browser:list": "tsx scripts/test-browser-suites.ts --list",
    "test:browser:all": "tsx scripts/test-browser-suites.ts",
    "test:catalog": "tsx scripts/test-catalog.ts",
    "test:unit:fast": "tsx scripts/test-node.ts unit",
    "test:sql": "tsx scripts/test-node.ts sql",
    "test:native": "tsx scripts/test-node.ts native",
    "test:coverage": "c8 tsx scripts/test-node.ts && tsx scripts/check-coverage.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage:combined": "tsx scripts/test-combined-coverage.ts",
    "test:coverage:merge": "tsx scripts/check-coverage.ts --combined",
    "test:coverage:production-clean": "tsx scripts/check-production-coverage.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "1.2.1",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "c8": "11.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
