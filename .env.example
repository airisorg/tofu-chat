# Tofu provides these values when the managed database is connected.
# Never commit a populated .env file or log these settings.
DATABASE_URL=
# PEM root of the database server's certificate; Tofu sets it. Never disable TLS verification.
SUPABASE_CA_CERT=
# Optional PEM CA bundle that replaces SUPABASE_CA_CERT for a provider you choose.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where Google sign-in starts (Tofu's broker, ending in /start); Tofu sets it. Without it, sign-in stays off.
TOFU_SIGN_IN_URL=
